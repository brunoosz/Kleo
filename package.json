{
  "name": "kleo-app",
  "private": true,
  "version": "1.0.0",
  "description": "Kleo: assistente pessoal para idosos, pessoas com deficiência e qualquer pessoa. Mais autonomia. Mais liberdade.",
  "author": {
    "name": "Kheo"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "celular": "vite --mode celular",
    "app:pc": "vite build && electron-builder --win --config electron/builder.cjs",
    "app:pc:dev": "node electron/dev.mjs",
    "app:android": "node scripts/app-android.mjs",
    "app:android:teste": "node scripts/app-android.mjs --so-teste",
    "app:ios": "vite build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/functions": "^3.11.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.68.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.30.6",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "vite": "^8.3.5"
  }
}

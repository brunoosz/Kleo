{
  "appId": "com.kheo.kleo",
  "appName": "Kleo",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#f7f4f2",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#f7f4f2",
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#f7f4f2",
      "showSpinner": false,
      "androidScaleType": "CENTER_INSIDE",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "SystemBars": {
      "style": "LIGHT",
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_kleo",
      "iconColor": "#000000"
    }
  }
}

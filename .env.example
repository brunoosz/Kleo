# =====================================================================================
# Kleo - modelo das variáveis de ambiente (NÃO coloque valores reais neste arquivo)
# 1. Copie este arquivo para .env.local (mesma pasta), preencha e reinicie o "npm run dev".
# 2. Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables e faça um novo deploy.
# O .env.local nunca vai para o GitHub (o .gitignore já ignora *.local).
# Passo a passo com o nome de cada botão: pasta kit/ (Kleo-kit.zip) e SUPABASE.md.
# =====================================================================================

# ---------- PÚBLICAS: vão para o navegador (qualquer um pode ver; é seguro) ----------

# Conversas entre pessoas (Supabase). Endereço do projeto: botão Connect ou Project Settings > Data API.
# Exemplo: https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=

# Chave PUBLISHABLE (sb_publishable_...) em Project Settings > API Keys, ou a anon antiga (eyJ...).
# NUNCA a secret: com a secret qualquer pessoa passaria por cima das regras do banco.
VITE_SUPABASE_ANON_KEY=

# Avisos com o app fechado (Web Push): chave PÚBLICA VAPID.
# Gere o par uma vez com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# ---------- SEGREDOS: só no servidor (.env.local e Vercel). Nunca com VITE_ na frente ----------

# IA da Kleo para qualquer pessoa, sem chave própria (funções em api/ia.js e api/transcrever.js).
# Chave grátis, sem cartão, criada em https://aistudio.google.com/app/apikey (começa com AIza).
GEMINI_API_KEY=

# Opcional: segundo provedor de IA (Groq), mais rápido no texto. Chave grátis em https://console.groq.com/keys (gsk_...).
GROQ_API_KEY=

# Chave SECRETA do Supabase (sb_secret_... ou a service_role antiga). Só o api/push.js usa.
SUPABASE_SERVICE_ROLE_KEY=

# Chave PRIVADA VAPID (o par da VITE_VAPID_PUBLIC_KEY, gerado junto).
VAPID_PRIVATE_KEY=

# Contato do responsável pelos avisos, no formato mailto: (exemplo: mailto:seu-email@exemplo.com)
VAPID_SUBJECT=

# ---------- Opcionais no servidor ----------
# Outros endereços que podem usar a IA da Kleo além do próprio site (ex.: domínio próprio),
# separados por vírgula: KLEO_ORIGENS=https://meusite.com.br,https://www.meusite.com.br
# KLEO_ORIGENS=

# Vazias = usam as VITE_ de cima
# SUPABASE_URL=
# VAPID_PUBLIC_KEY=
